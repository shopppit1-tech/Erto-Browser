{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile for Erto Browser cloud sync.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "updatedAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Synced browser bookmark belonging to a single user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1024
        },
        "iconKey": {
          "type": "string",
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "maxLength": 40
        },
        "pinnedOnHome": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "url", "iconKey", "category", "pinnedOnHome", "createdAt"]
    },
    "UserHistory": {
      "title": "UserHistory",
      "description": "Synced browsing history entry belonging to a single user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1024
        },
        "visitedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "url", "visitedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document containing Google account metadata."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Bookmarks owned by the authenticated user."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/UserHistory" },
      "description": "Browsing history owned by the authenticated user."
    }
  }
}
