rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'url', 'iconKey', 'category', 'pinnedOnHome', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'url', 'iconKey', 'category', 'pinnedOnHome', 'createdAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.url is string
        && data.url.size() >= 4
        && data.url.size() <= 1024
        && data.iconKey is string
        && data.iconKey.size() >= 1
        && data.iconKey.size() <= 40
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 40
        && data.pinnedOnHome is bool
        && data.createdAt is timestamp;
    }

    function isValidHistory(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'url', 'visitedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'url', 'visitedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.url is string
        && data.url.size() >= 4
        && data.url.size() <= 1024
        && data.visitedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /bookmarks/{bookmarkId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(bookmarkId)
          && isValidBookmark(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(bookmarkId)
          && isValidBookmark(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'iconKey', 'category', 'pinnedOnHome']);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      match /history/{historyId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(historyId);
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && isValidHistory(incoming(), userId)
          && incoming().visitedAt == request.time;
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(historyId);
      }
    }
  }
}
